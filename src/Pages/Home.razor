@page "/"
@inject IJSRuntime JsRuntime

<main class="container">
    <h1>Welcome to RustyChat</h1>
    <p>This is a simple chat application built with Tauri and Blazor.</p>

    <form class="row" @onsubmit="LoginAsync" @onsubmit:preventDefault="true">
        <input id="greet-input" placeholder="Enter your username" @bind="EmailInput"/>
        <input id="greet-password" placeholder="Enter your password" type="password"/>
        <button type="submit">Login</button>
    </form>

</main>

@code
{
    private string? EmailInput { get; set; }

    private async Task LoginAsync()
    {

    }
}
